pipeline {
    agent any

    environment {
        PYTHONPATH = 'workspace'
        DB_HOST     = 'my_shop_db'
        DB_NAME     = 'postgres'
        DB_USER     = 'postgres'
        DB_PASS     = 'mysecretpassword'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('lesson_29') {
                    sh 'pip install -r requirements.txt'
                }
            }
        }

        stage('Run Tests') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    dir('lesson_29') {
                        sh 'pytest -v --alluredir=allure-results'
                    }
                }
            }
        }

        stage('Publish Results') {
            steps {
                allure includeProperties: false, jdk: '', results: [[path: 'lesson_29/allure-results']]
            }
        }
    }

    post {
        always {
            mail to: 'InsertYour@Mail.Here',
                 subject: "Jenkins Build #${env.BUILD_NUMBER} - ${currentBuild.currentResult}",
                 body: """Hello!

Pipeline has finished with status: ${currentBuild.currentResult}.

Details of the assembly and the Allure report can be viewed at the link: ${env.BUILD_URL}

Your Jenkins server."""
        }
    }
}